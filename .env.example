# Supabase (Project Settings → API). O app usa só a chave pública.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Claude API: atendente de IA, copiloto do dono e mensagem de reconquista.
# Sem a chave o sistema funciona normalmente; só a IA responde "não configurado".
ANTHROPIC_API_KEY=
# Opcional: troque o modelo (padrão: claude-opus-5-5). Em produção usamos o Haiku, mais barato.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Pagamentos (checkout do sinal): desligado por padrão. Só defina quando for ligar a cobrança
# online para algum estabelecimento. Chave mestra com 32 caracteres ou mais, usada no servidor para
# cifrar as credenciais dos estabelecimentos. Se ela mudar, as credenciais guardadas param de valer.
# Gere com: openssl rand -base64 48
# PAYMENTS_SECRET=
